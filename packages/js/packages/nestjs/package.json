{
  "name": "@phinehas/nestjs",
  "version": "1.0.0",
  "type": "module",
  "description": "Phinehas active defense middleware module for NestJS applications",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/finalize-cjs.mjs",
    "test": "node --test tests/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@phinehas/core": "^1.0.0",
    "@phinehas/node": "^1.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0"
  },
  "keywords": [
    "nestjs",
    "security",
    "middleware",
    "active-defense"
  ],
  "author": "Phinehas HQ",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
