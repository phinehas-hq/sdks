{
  "name": "@phinehas/core",
  "version": "1.0.0",
  "type": "module",
  "description": "Core RFC 8615 detection engine, path normalizer, and BanStore state management for Phinehas",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/finalize-cjs.mjs",
    "test": "node --test tests/*.test.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "security",
    "middleware",
    "waf",
    "active-defense",
    "rfc8615",
    "bot-defense"
  ],
  "author": "Phinehas HQ",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
