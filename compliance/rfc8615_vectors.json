{
  "description": "RFC 8615 Wildcard Rule Test Vectors (^/\\.(?!well-known(/|$))[a-zA-Z0-9_\\-\\.]+)",
  "cases": [
    {
      "path": "/.env",
      "expected_strike": true,
      "reason": "Root environment file"
    },
    {
      "path": "/.env.local",
      "expected_strike": true,
      "reason": "Local environment overrides"
    },
    {
      "path": "/.env.production",
      "expected_strike": true,
      "reason": "Production environment credentials"
    },
    {
      "path": "/.env.bak",
      "expected_strike": true,
      "reason": "Environment backup file"
    },
    {
      "path": "/.git",
      "expected_strike": true,
      "reason": "Git repository root directory"
    },
    {
      "path": "/.git/HEAD",
      "expected_strike": true,
      "reason": "Git HEAD ref file"
    },
    {
      "path": "/.git/config",
      "expected_strike": true,
      "reason": "Git repository configuration"
    },
    {
      "path": "/.gitignore",
      "expected_strike": true,
      "reason": "Git ignore patterns"
    },
    {
      "path": "/.aws/credentials",
